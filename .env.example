# Скопируй в .env и заполни. .env в git не попадает.

# Для скрипта (сервер / GitHub Actions)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...   # Project Settings → API Keys → Secret keys. Обходит RLS, только для сервера!
TELEGRAM_BOT_TOKEN=                 # от @BotFather
TELEGRAM_CHAT_ID=                   # узнаем на этапе 3

# Для веб-страницы (этап 7). VITE_* попадают в браузер — сюда только публичный ключ.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
